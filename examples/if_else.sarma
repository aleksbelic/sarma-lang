// Sarma if / else: braces required, `else` optional, `else if` chains work.

var n = 2
if (n == 1) {
  print("one")
} else if (n == 2) {
  print("two")
} else {
  print("other")
}

if (n > 10) {
  print("big")
}
print("done")

if (true) { print("one-liner") }
if (n == 2) print("bare, no braces needed")
