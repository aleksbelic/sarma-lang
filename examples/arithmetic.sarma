// Sarma numbers + arithmetic.
// `*` `/` `%` bind tighter than `+` `-`; use parens to override.

print(1 + 2 * 3)    // 7
print((1 + 2) * 3)  // 9
print(10 - 2 - 3)   // 5, left-associative
print(7 / 2)        // 3.5
print(6 / 2)        // 3 (whole floats print without decimals)
print(7 % 3)        // 1
print(-5 + 2)       // -3

var x = 3
var y = 5
print(x * y + 1)    // 16
x = x + 10
print(x)            // 13
